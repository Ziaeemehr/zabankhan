    <string name="b_words_csv_import_help_excel">Excel: File › Save As › "CSV UTF-8". Google Sheets: File › Download › CSV. Semicolon or tab separated files work too. If a sentence contains a comma, put it in double quotes (Excel and Sheets do this automatically).</string>
    <string name="b_words_csv_import_help_title">Import words</string>
